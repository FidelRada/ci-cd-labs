<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>bo.diplomado</groupId>
	<artifactId>calculadora</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>calculadora</name>
	<description>Calculadora de ejemplo para el Laboratorio 3 del módulo de CI/CD</description>

	<properties>
		<java.version>21</java.version>
		<jacoco.version>0.8.13</jacoco.version>
		<!-- Quality Gate: cobertura mínima de líneas exigida por el pipeline -->
		<jacoco.cobertura.minima>0.80</jacoco.cobertura.minima>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				JaCoCo: mide la cobertura de código durante las pruebas,
				genera el reporte HTML/XML y aplica el Quality Gate.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<excludes>
						<!-- La clase de arranque solo contiene el main() de Spring Boot -->
						<exclude>**/CalculadoraApplication.class</exclude>
					</excludes>
					<!--
						Reglas del Quality Gate. Se declaran a nivel de plugin (y no
						dentro de la ejecución) para que también apliquen cuando el
						pipeline invoca la meta suelta `jacoco:check`.
					-->
					<rules>
						<rule>
							<element>BUNDLE</element>
							<limits>
								<limit>
									<counter>LINE</counter>
									<value>COVEREDRATIO</value>
									<minimum>${jacoco.cobertura.minima}</minimum>
								</limit>
							</limits>
						</rule>
					</rules>
				</configuration>
				<executions>
					<!-- 1. Instrumenta el código antes de ejecutar las pruebas -->
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>

					<!-- 2. Genera el reporte en target/site/jacoco/ -->
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>

					<!-- 3. Quality Gate: falla la construcción si no se alcanza el mínimo -->
					<execution>
						<id>quality-gate</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
